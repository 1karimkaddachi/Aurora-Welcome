# ── Discord application ─────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID — used by the bot and OAuth2 dashboard login
DISCORD_CLIENT_ID=
# OAuth2 client secret — required for dashboard login
DISCORD_CLIENT_SECRET=

# ── Dashboard ──────────────────────────────────────────────────────
# Public base URL of the dashboard (must match the OAuth2 redirect)
DASHBOARD_URL=http://localhost:3000
# Redirect URI registered in the Developer Portal:
#   <DASHBOARD_URL>/auth/callback
PORT=3000
# Random 48+ character secret used to sign OAuth state cookies / CSRF tokens
SESSION_SECRET=replace-me-with-a-long-random-string

# ── Runtime ────────────────────────────────────────────────────────
DATA_DIR=./data
LOG_LEVEL=info
# Register slash commands to one guild instantly while developing.
# Leave empty for global commands (can take up to 1 hour to propagate).
DISCORD_GUILD_ID=

# ── Local development only (NEVER enable in production) ────────────
# Lets you sign into the dashboard with a seeded guild without Discord OAuth.
ALLOW_DEV_AUTH=false
DEV_GUILD_ID=
DEV_USER_ID=
